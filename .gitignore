tsconfig.tsbuildinfo
src/generated/
__pycache__/
*.py[cod]
.DS_Store
.vscode/
.idea/

# Local authentication and diagnostic artifacts
/feishu-docs-auth-qr.png
/vla-disk-note.xml
/scripts/.probe/
